# Copy this file to .env and fill in values for your setup. .env itself is
# gitignored - only this .example file is meant to be committed.

# Where the frontend sends API requests. The deployed frontend
# (https://lovestory.madgen.space) and backend (https://api.madgen.space) live
# on different origins, so this MUST point at the backend's own origin - no
# trailing slash and no /api suffix - otherwise the built app calls a relative
# /api/... path on the frontend origin and gets back HTML instead of JSON
# ("The server returned an unreadable response.").
VITE_API_BASE_URL=https://api.madgen.space