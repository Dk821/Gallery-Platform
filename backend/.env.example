# Database
DATABASE_URL=mysql+pymysql://gallery_user:CHANGE_ME@localhost:3306/gallery_db

# Google Drive (server-side only, never exposed to frontend)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# ID of the Drive folder that acts as the "Clients" parent folder - create
# one folder manually in the target Drive account first, grant the OAuth
# account access to it, then paste its folder ID here. Every client folder
# is created directly under this folder.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Sessions / crypto
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
SESSION_TTL_MINUTES=1440
# Set to true ONLY if the frontend is hosted on a different origin/domain
# than this backend (e.g. frontend on Vercel, backend on your own VPS
# under a different domain). Forces session cookies to SameSite=None;
# Secure so they're actually sent on cross-origin API calls - requires
# this API to be served over HTTPS. Leave false for same-origin
# deployments (frontend and backend behind the same domain).
CROSS_SITE_FRONTEND=false

# CORS
CORS_ORIGINS=https://abc.com,https://www.abc.com

# Uploads
MAX_UPLOAD_SIZE_BYTES=10737418240
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp,gif
ALLOWED_VIDEO_TYPES=mp4,mov,webm

# ZIP download jobs (background-generated album/selection downloads)
# Local disk directory where in-progress and completed ZIPs are written -
# needs enough free space for the largest album anyone will download at
# once, and should be on the same disk as everything else on the VPS
# (Section 14's 50GB NVMe applies here too).
ZIP_TEMP_DIR=/tmp/gallery_zip_jobs
# How long a completed ZIP stays downloadable before the cleanup job
# removes it - see `python -m app.cleanup_download_jobs` in the README.
ZIP_JOB_TTL_HOURS=24
# Sanity ceiling on how many files a single ZIP job will attempt.
ZIP_JOB_MAX_FILES=5000
# How many files the ZIP job downloads from storage simultaneously before
# assembling them into the archive. Downloads are network-bound, so a
# modest concurrency (default 4) shortens multi-file job wall time a lot;
# memory stays flat because each prefetch lands in a temp file on disk.
ZIP_JOB_PARALLEL_DOWNLOADS=4

# Resumable Google Drive upload hardening
# How many uploads may be actively transferring to Drive at once.
UPLOAD_MAX_CONCURRENT=3
# Resumable upload chunk size in MB (rounded to the nearest 256 KiB
# multiple, as Drive's resumable protocol requires).
UPLOAD_CHUNK_SIZE_MB=8
UPLOAD_MAX_RETRIES=5
UPLOAD_INITIAL_BACKOFF_SECONDS=0.5
UPLOAD_MAX_BACKOFF_SECONDS=20
# Extra per-file size ceiling in MB, independent of MAX_UPLOAD_SIZE_BYTES
# above - the smaller of the two always wins.
UPLOAD_MAX_FILE_SIZE_MB=10240
# Minimum free disk space (GB) that must remain available, accounting for
# every other upload's reservation, before a new upload is accepted.
UPLOAD_MIN_FREE_DISK_GB=5
# Per-chunk network timeout and an overall ceiling on one upload's total
# transfer time, both in seconds.
UPLOAD_CHUNK_TIMEOUT=120
UPLOAD_SESSION_TIMEOUT=3600
# How long a Drive file with no matching database record is left alone
# before `python -m app.reconcile_orphans --apply` will delete it.
ORPHAN_FILE_GRACE_PERIOD_HOURS=48

# App
ENVIRONMENT=development
